<Page x:Class="CinemaTicketBooking.Views.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Schedule"
      Background="Transparent">
    <Grid Margin="28,8,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Schedule" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Halls define the seat map. Showtimes put a film on the board." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <ui:Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding RefreshCommand}" />
        </Grid>

        <ui:InfoBar Grid.Row="1"
                    Margin="0,16,0,0"
                    Title="{Binding StatusMessage}"
                    IsOpen="{Binding HasStatus, Mode=TwoWay}"
                    IsClosable="True"
                    Severity="Success" />

        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" MinWidth="280" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Halls" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <DataGrid ItemsSource="{Binding Halls}"
                                      SelectedItem="{Binding SelectedHall}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      MinHeight="160"
                                      MaxHeight="220"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Hall" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="100" />
                                    <DataGridTextColumn Header="Rows" Binding="{Binding RowCount}" Width="70" />
                                    <DataGridTextColumn Header="Seats" Binding="{Binding SeatsPerRow}" Width="70" />
                                    <DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding HallHeading}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding HallName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Rows" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding RowCountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Seats per row" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SeatsPerRowText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Format" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding HallFormats}" SelectedItem="{Binding HallFormat}" Margin="0,0,0,14" />
                            <UniformGrid Columns="3">
                                <ui:Button Content="New" Margin="0,0,8,0" Command="{Binding NewHallCommand}" />
                                <ui:Button Appearance="Primary" Content="Save" Margin="0,0,8,0" Command="{Binding SaveHallCommand}" />
                                <ui:Button Appearance="Danger" Content="Delete" Command="{Binding DeleteHallCommand}" />
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <ui:Card Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" MinWidth="280" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
                                <TextBlock Text="Screenings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <CheckBox Content="Upcoming only" IsChecked="{Binding UpcomingOnly}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="No screenings in this list."
                                       Opacity="0.7"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding HasShows, Converter={StaticResource InverseBoolToVis}}" />
                            <DataGrid ItemsSource="{Binding Showtimes}"
                                      SelectedItem="{Binding SelectedShow}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      MinHeight="220"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="When" Binding="{Binding WhenLabel}" Width="180" />
                                    <DataGridTextColumn Header="Film" Binding="{Binding MovieTitle}" Width="*" />
                                    <DataGridTextColumn Header="Hall" Binding="{Binding HallName}" Width="150" />
                                    <DataGridTextColumn Header="Price" Binding="{Binding TicketPrice, StringFormat=C}" Width="90" />
                                    <DataGridTextColumn Header="Seats" Binding="{Binding OccupancyLabel}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding ShowHeading}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="Film" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding MovieChoices}"
                                      SelectedItem="{Binding SelectedMovieChoice}"
                                      DisplayMemberPath="Title"
                                      Margin="0,0,0,10" />
                            <TextBlock Text="Hall" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Halls}"
                                      SelectedItem="{Binding SelectedHallChoice}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,10" />
                            <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding ShowDate}" Margin="0,0,0,10" />
                            <TextBlock Text="Start time" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            <TextBlock Text="Ticket price" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <ui:Button Content="New" Margin="0,0,8,0" Command="{Binding NewShowCommand}" />
                                <ui:Button Appearance="Primary" Content="Save" Command="{Binding SaveShowCommand}" />
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <ui:Button Content="Cancel show" Margin="0,0,8,0" Command="{Binding CancelShowCommand}" />
                                <ui:Button Appearance="Danger" Content="Delete" Command="{Binding DeleteShowCommand}" />
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
