<Page x:Class="CinemaTicketBooking.Views.BookingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Bookings"
      Background="Transparent">
    <Grid Margin="28,8,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Bookings" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Find a ticket and cancel it if the guest is not coming. Seats go back on sale." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Grid>

        <ui:InfoBar Grid.Row="1"
                    Margin="0,16,0,0"
                    Title="{Binding StatusMessage}"
                    IsOpen="{Binding HasStatus, Mode=TwoWay}"
                    IsClosable="True"
                    Severity="Success" />

        <ui:Card Grid.Row="2" Margin="0,16,0,0" Padding="16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Search code, guest, phone, or film" />
                    <ui:Button Grid.Column="1" Content="Search" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
                    <ui:Button Grid.Column="2"
                               Appearance="Danger"
                               Content="Cancel booking"
                               Margin="8,0,0,0"
                               Command="{Binding CancelCommand}" />
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                           Text="No bookings match."
                           Opacity="0.7"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasBookings, Converter={StaticResource InverseBoolToVis}}" />
                <DataGrid ItemsSource="{Binding Bookings}"
                          SelectedItem="{Binding SelectedBooking}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding BookingCode}" Width="120" />
                        <DataGridTextColumn Header="Guest" Binding="{Binding CustomerName}" Width="*" />
                        <DataGridTextColumn Header="Film" Binding="{Binding MovieTitle}" Width="*" />
                        <DataGridTextColumn Header="When" Binding="{Binding StartsAt, StringFormat=ddd dd MMM HH:mm}" Width="150" />
                        <DataGridTextColumn Header="Seats" Binding="{Binding SeatSummary}" Width="140" />
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C}" Width="100" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </ui:Card>
    </Grid>
</Page>
