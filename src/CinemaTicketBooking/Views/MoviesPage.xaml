<Page x:Class="CinemaTicketBooking.Views.MoviesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Movies"
      Background="Transparent">
    <Grid Margin="28,8,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <ui:Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding RefreshCommand}" />
        </Grid>

        <ui:InfoBar Grid.Row="1"
                    Margin="0,16,0,0"
                    Title="{Binding StatusMessage}"
                    IsOpen="{Binding HasStatus, Mode=TwoWay}"
                    IsClosable="True"
                    Severity="Success" />

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Card Padding="16">
                <DockPanel>
                    <ui:TextBox DockPanel.Dock="Top"
                             Margin="0,0,0,12"
                             PlaceholderText="Search title, genre, or director"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGrid ItemsSource="{Binding Movies}"
                              SelectedItem="{Binding SelectedMovie}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="120" />
                            <DataGridTextColumn Header="Rating" Binding="{Binding RatingLabel}" Width="80" />
                            <DataGridTextColumn Header="Length" Binding="{Binding DurationLabel}" Width="90" />
                            <DataGridTextColumn Header="Board" Binding="{Binding BoardLabel}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </ui:Card>

            <ui:Card Grid.Column="1" Padding="18" Margin="16,0,0,0" MinWidth="320"
                     Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorHeading}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

                        <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="Genre" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="Director" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Director, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="Language" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="Certificate" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding AgeRatings}" SelectedItem="{Binding AgeRating}" Margin="0,0,0,12" />

                        <TextBlock Text="Duration (minutes)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 Margin="0,0,0,12" />

                        <CheckBox Content="On the board" IsChecked="{Binding IsOnBoard}" Margin="0,0,0,16" />

                        <UniformGrid Columns="3">
                            <ui:Button Content="New" Margin="0,0,8,0" Command="{Binding NewMovieCommand}" />
                            <ui:Button Appearance="Primary" Content="Save" Margin="0,0,8,0" Command="{Binding SaveCommand}" />
                            <ui:Button Appearance="Danger" Content="Delete" Command="{Binding DeleteCommand}" />
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
