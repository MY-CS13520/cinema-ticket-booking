<Page x:Class="CinemaTicketBooking.Views.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Payments"
      Background="Transparent">
    <Grid Margin="28,8,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Payments" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Track what is paid, still due, or refunded." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ui:InfoBar Grid.Row="1"
                    Margin="0,16,0,0"
                    Title="{Binding StatusMessage}"
                    IsOpen="{Binding HasStatus, Mode=TwoWay}"
                    IsClosable="True"
                    Severity="Success" />

        <ui:Card Grid.Row="2" Margin="0,16,0,0" Padding="16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" />
                    <ui:Button Grid.Column="2" Content="Mark paid" Margin="8,0,0,0" Command="{Binding MarkPaidCommand}" />
                    <ui:Button Grid.Column="3" Appearance="Danger" Content="Refund" Margin="8,0,0,0" Command="{Binding RefundCommand}" />
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                           Text="No payments in this list."
                           Opacity="0.7"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasPayments, Converter={StaticResource InverseBoolToVis}}" />
                <DataGrid ItemsSource="{Binding Payments}"
                          SelectedItem="{Binding SelectedPayment}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Booking" Binding="{Binding BookingCode}" Width="120" />
                        <DataGridTextColumn Header="Guest" Binding="{Binding CustomerName}" Width="*" />
                        <DataGridTextColumn Header="Film" Binding="{Binding MovieTitle}" Width="*" />
                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="90" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="110" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Paid" Binding="{Binding PaidAt, StringFormat=dd MMM HH:mm}" Width="120" />
                        <DataGridTextColumn Header="Refunded" Binding="{Binding RefundedAt, StringFormat=dd MMM HH:mm}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </ui:Card>
    </Grid>
</Page>
