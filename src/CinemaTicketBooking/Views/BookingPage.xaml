<Page x:Class="CinemaTicketBooking.Views.BookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Book tickets"
      Background="Transparent">
    <Grid Margin="28,8,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Book tickets" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Choose a screening, tap seats, and take payment." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <ui:Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding RefreshCommand}" />
        </Grid>

        <ui:InfoBar Grid.Row="1"
                    Margin="0,16,0,0"
                    Title="{Binding StatusMessage}"
                    IsOpen="{Binding HasStatus, Mode=TwoWay}"
                    IsClosable="True"
                    Severity="Success" />

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <ui:Card Padding="12" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Screenings" FontSize="16" FontWeight="SemiBold" Margin="4,4,4,8" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="No screenings on the board."
                               Margin="4,0,4,8"
                               Opacity="0.7"
                               Visibility="{Binding HasShowtimes, Converter={StaticResource InverseBoolToVis}}" />
                    <ListBox ItemsSource="{Binding Showtimes}"
                             SelectedItem="{Binding SelectedShowtime}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,6">
                                    <TextBlock Text="{Binding MovieTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.75" Text="{Binding WhenLabel}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.75" Text="{Binding HallName}" />
                                    <TextBlock Foreground="{StaticResource CinemaGoldBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:C}   ·   {1} left">
                                                <Binding Path="TicketPrice" />
                                                <Binding Path="SeatsLeft" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </ui:Card>

            <ui:Card Grid.Column="1" Margin="0,0,12,0" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Border Height="28"
                                MinWidth="220"
                                CornerRadius="8"
                                Background="#E4B15A"
                                Margin="0,0,0,8">
                            <TextBlock Text="SCREEN"
                                       Foreground="#1A1408"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="14" Height="14" CornerRadius="4" Background="#2A3140" BorderBrush="#66E4B15A" BorderThickness="1" Margin="0,0,6,0" />
                            <TextBlock Text="Open" Margin="0,0,14,0" Opacity="0.8" />
                            <Border Width="14" Height="14" CornerRadius="4" Background="#E4B15A" Margin="0,0,6,0" />
                            <TextBlock Text="Selected" Margin="0,0,14,0" Opacity="0.8" />
                            <Border Width="14" Height="14" CornerRadius="4" Background="#3A3034" Margin="0,0,6,0" />
                            <TextBlock Text="Booked" Opacity="0.8" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top"
                               Text="Select a screening to open the seat map."
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0"
                               Opacity="0.7"
                               Visibility="{Binding HasShow, Converter={StaticResource InverseBoolToVis}}" />

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rows}" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1">
                                        <TextBlock Text="{Binding Label}"
                                                   Width="22"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.7" />
                                        <ItemsControl ItemsSource="{Binding Seats}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Number}"
                                                            Style="{StaticResource SeatButtonStyle}"
                                                            Command="{Binding DataContext.ToggleSeatCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </ui:Card>

            <ui:Card Grid.Column="2" Padding="18">
                <StackPanel>
                    <TextBlock Text="Checkout" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedShowtime.MovieTitle}" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedShowtime.WhenLabel}" Opacity="0.75" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedShowtime.HallName}" Opacity="0.75" Margin="0,0,0,12" />

                    <TextBlock Text="Guest name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <TextBlock Text="Payment" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Margin="0,0,0,10" />

                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding SaleStatuses}" SelectedItem="{Binding PaymentStatus}" Margin="0,0,0,14" />

                    <TextBlock Text="{Binding SeatSummary}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,16" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource CinemaGoldBrush}" Text="{Binding TotalAmount, StringFormat=C}" />

                    <ui:Button Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Content="Confirm booking"
                               Command="{Binding ConfirmCommand}" />
                    <TextBlock Margin="0,10,0,0"
                               Opacity="0.65"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="Pending stays on the payments list until you mark it paid." />
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
