<ui:FluentWindow x:Class="CinemaTicketBooking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Lumina Cinema"
        Height="900"
        Width="1380"
        MinHeight="720"
        MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title strip is its own row so it does not cover the pane toggle. -->
        <ui:TitleBar Grid.Row="0" Title="Lumina Cinema" />

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            IsPaneToggleVisible="True"
            OpenPaneLength="248"
            CompactPaneLength="64"
            IsBackButtonVisible="Collapsed">
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="20,8,12,12">
                    <TextBlock Text="LUMINA" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CinemaGoldBrush}" />
                    <TextBlock x:Name="SignedInText" Text="Cinema desk" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </ui:NavigationView.PaneHeader>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
