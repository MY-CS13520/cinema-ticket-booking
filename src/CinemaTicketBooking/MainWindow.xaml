<ui:FluentWindow x:Class="CinemaTicketBooking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:CinemaTicketBooking.Views"
        Title="Lumina Cinema"
        Height="900"
        Width="1380"
        MinHeight="720"
        MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <ui:NavigationView
            x:Name="RootNavigation"
            Padding="0,46,0,0"
            PaneDisplayMode="Left"
            OpenPaneLength="248"
            IsBackButtonVisible="Collapsed">
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="20,8,12,12">
                    <TextBlock Text="LUMINA" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CinemaGoldBrush}" />
                    <TextBlock Text="Cinema desk" FontSize="12" Opacity="0.7" />
                </StackPanel>
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem Content="Movies" Icon="{ui:SymbolIcon Filmstrip24}" TargetPageType="{x:Type pages:MoviesPage}" />
                <ui:NavigationViewItem Content="Schedule" Icon="{ui:SymbolIcon CalendarLtr24}" TargetPageType="{x:Type pages:SchedulePage}" />
                <ui:NavigationViewItem Content="Book tickets" Icon="{ui:SymbolIcon TicketHorizontal24}" TargetPageType="{x:Type pages:BookingPage}" />
                <ui:NavigationViewItem Content="Bookings" Icon="{ui:SymbolIcon Receipt24}" TargetPageType="{x:Type pages:BookingsPage}" />
                <ui:NavigationViewItem Content="Payments" Icon="{ui:SymbolIcon Payment24}" TargetPageType="{x:Type pages:PaymentsPage}" />
                <ui:NavigationViewItem Content="Sales reports" Icon="{ui:SymbolIcon DataHistogram24}" TargetPageType="{x:Type pages:ReportsPage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
        <ui:TitleBar Title="Lumina Cinema" />
    </Grid>
</ui:FluentWindow>
